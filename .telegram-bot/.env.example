# MacMini-AI-Coach Telegram Bot
# Environment Configuration Template
#
# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in the values below
# 3. Run: python3 bot.py --setup (to encrypt your token)
# 4. Set file permissions: chmod 600 .env

# Your Telegram bot token from @BotFather
# Get it at: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Strong password for AES-256-CBC token encryption
# Save this securely — you'll need it if you rebuild the bot
TOKEN_ENCRYPT_PASSWORD=your-strong-password-here

# Your Telegram user ID (whitelist)
# Get it at: https://t.me/userinfobot
# Example: 987654321
ALLOWED_USER_IDS=YOUR_TELEGRAM_USER_ID_HERE

# OpenClaw endpoint (primary LLM router)
OPENCLAW_URL=http://localhost:8000

# Ollama endpoint (fallback if OpenClaw is down)
OLLAMA_URL=http://localhost:11434

# Default Ollama model to use
OLLAMA_MODEL=qwen3:14b
